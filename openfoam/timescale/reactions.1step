/*  Global 1-step CH4/air mechanism, same rate data as Fluent's "methane-air" mixture (SI):
      CH4 + 2 O2 -> CO2 + 2 H2O    A 2.119e11  Ea 2.027e8 J/kmol  orders CH4^0.2 O2^1.3
    Check case for the timescale roadmap (step 1).  */
elements        4(H O C N);

species
5
(
CH4
O2
H2O
CO2
N2
)
;

reactions
{
    ws1-R1
    {
        type            irreversibleArrheniusReaction;
        reaction        "CH4^0.2 + 2O2^1.3 = CO2 + 2H2O";
        A               2.119e+11;
        beta            0;
        Ta              24379.2;
    }
}
