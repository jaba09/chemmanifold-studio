#!/bin/sh
# Builds libarcChemStep: ARC_GRI30_NOx22 (22 ODE + 21 LQSSA species) chemistry
# for OpenFOAM, with the plain-C core from mechanisms/arc_gri30_nox22.
cd "${0%/*}" || exit 1
M=../../mechanisms/arc_gri30_nox22
cp $M/arc_gri30_nox22.c $M/arc_gri30_nox22.h $M/arc_gri30_nox22_data.h .
wmake libso
