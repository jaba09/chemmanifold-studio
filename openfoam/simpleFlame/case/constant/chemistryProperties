FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// Simple laminar CH4/air coflow flame (openfoam/simpleFlame), the OpenFOAM half of the
// Fluent-vs-OpenFOAM comparison. Mesh from ../make_mesh.py (same cells as coflow.msh).

chemistryType
{
    solver          ode;            // or userChemStep
    method          standard;
}

chemistry           on;

initialChemicalTimeStep 1e-07;

odeCoeffs
{
    solver          seulex;
    absTol          1e-10;
    relTol          1e-05;
}

