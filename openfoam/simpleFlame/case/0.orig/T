FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// Simple laminar CH4/air coflow flame (openfoam/simpleFlame), the OpenFOAM half of the
// Fluent-vs-OpenFOAM comparison. Mesh from ../make_mesh.py (same cells as coflow.msh).

dimensions          [0 0 0 1 0 0 0];
internalField       uniform 300;                // cold air; setFieldsDict lights a hot kernel at the nozzle
boundaryField
{
    "inlet.*"
    {
        type            fixedValue;
        value           uniform 300;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;
    }
    side
    {
        type            symmetryPlane;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
