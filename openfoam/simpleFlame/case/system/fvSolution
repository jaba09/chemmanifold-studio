FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// Simple laminar CH4/air coflow flame (openfoam/simpleFlame)

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "(U|h)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }

    "(U|h)Final"
    {
        $U;
        relTol          0;
    }

    Yi
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.1;
    }
}

PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    1;
    nCorrectors         1;
    nNonOrthogonalCorrectors 0;

    // local time-step control (LTS)
    maxDeltaT           0.01;
    maxCo               0.5;
    alphaTemp           0.2;    // limit the temperature change per step to 20 %
    alphaY              0.05;   // and the change of the reference species below
    Yref
    {
        O2              0.1;
        CH4             0.1;
    }
    rDeltaTSmoothingCoeff 1;    // no spatial smoothing of the local time step
    rDeltaTDampingCoeff 1;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

