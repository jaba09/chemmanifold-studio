/*--------------------------------*- C++ -*----------------------------------*\
  Single-flame burner (quemadorUnico), converted from Fluent 20.2
  quemadorUnicoTesis_60KCells-GA18--ID-UDF.cas.h5
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [1 -1 -2 0 0 0 0];

internalField       uniform 101325;

boundaryField
{
    ".*"
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    "(outlet-lab|wall-fff-fluid-exhaust)"
    {
        // Fluent: pressure outlets at the top of the domain (x = 0.52 m): the room top
        // (outlet-lab, r 0.02-0.14 m) and the chimney exit (wall-fff-fluid-exhaust,
        // r < 0.02 m), 0 Pa gauge. Both lie at the same height, so fixing p_rgh is the
        // same as fixing p. (Before 2026-11-05 the case had the r = 0.14 m side open and
        // these two closed; that was a set-up error in the Fluent case.)
        type            fixedValue;
        value           $internalField;
    }

    "(front|back)"
    {
        type            wedge;
    }
}

// ************************************************************************* //
