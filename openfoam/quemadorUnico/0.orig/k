/*--------------------------------*- C++ -*----------------------------------*\
  Single-flame burner (quemadorUnico), converted from Fluent 20.2
  quemadorUnicoTesis_60KCells-GA18--ID-UDF.cas.h5
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluent: turbulent intensity 5 %, viscosity ratio 10 at every inlet: k = 1.5 (0.05 U)^2
dimensions          [0 2 -2 0 0 0 0];

internalField       uniform 1e-05;

boundaryField
{
    inlet-fuel
    {
        type            fixedValue;
        value           uniform 1.039e-03;      // U = 0.526 m/s
    }

    inlet-coflow-fff-fluid-mixing
    {
        type            fixedValue;
        value           uniform 9.48e-08;       // U = 5.0 mm/s
    }

    inlet-coflow-fff-fluid-exterior
    {
        type            fixedValue;
        value           uniform 9.375e-06;      // U = 0.05 m/s
    }

    outlet-lab-026
    {
        type            inletOutlet;
        inletValue      uniform 9.375e-06;
        value           uniform 9.375e-06;
    }

    wall
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    "(front|back)"
    {
        type            wedge;
    }
}

// ************************************************************************* //
