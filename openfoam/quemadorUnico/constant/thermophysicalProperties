FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fluent: ideal gas, kinetic-theory viscosity/conductivity, mixing-law cp (NASA polynomials)
thermoType
{
    type            heRhoThermo;
    mixture         reactingMixture;   // species + reactions from the chemistry files below
    transport       sutherland;     // fitted to the Chemkin LJ data, see chemkin/transportProperties
    thermo          janaf;
    energy          sensibleEnthalpy;
    equationOfState perfectGas;
    specie          specie;
}

inertSpecie         N2;

chemistryReader     foamChemistryReader;
foamChemistryFile   "<constant>/reactions";              // written by chemkinToFoam (Allrun)
foamChemistryThermoFile "<constant>/thermo.compressibleGas";

